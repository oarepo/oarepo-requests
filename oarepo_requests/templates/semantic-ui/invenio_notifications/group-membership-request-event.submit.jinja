{% set request = notification.context.request %}
{% set topic = request.topic %}
{% set topic_name = topic.description or topic.name or topic.id %}
{% set request_html_page = request.links.self_html %}
{% set justification = request.payload.justification %}

{%- block subject -%}
    {{ _("Request for group membership: {topic_name}").format(topic_name=topic_name) }}
{%- endblock subject -%}

{%- block html_body -%}
    {% trans topic_name=topic_name, link=request_html_page %}
    <p>
    A request has been made to join the group "{{topic_name}}".
    </p>
    <p>
        <a type="button" href='{{link}}'>Accept or Decline the request</a>
    </p>
    {% endtrans %}
    {%- if justification %}
    <p>
        <strong>{{ _("Justification:") }}</strong> {{ justification }}
    </p>
    {%- endif %}
    <table style="font-family:'Lato',Helvetica,Arial,sans-serif;border-spacing:15px">
        <tr>
            <td style="font-size:smaller">{{ _("This is an auto-generated message. To manage notifications, visit your")}} <a href="{{account_settings_link}}">{{ _("account settings")}}</a>.</td>
        </tr>
    </table>
{%- endblock html_body -%}

{%- block plain_body -%}
    {% trans topic_name=topic_name, link=request_html_page %}
    A request has been made to join the group "{{topic_name}}".
    Accept or Decline the request at {{link}}
    {% endtrans %}
    {%- if justification %}
    {{ _("Justification:") }} {{ justification }}
    {%- endif %}
{%- endblock plain_body -%}
