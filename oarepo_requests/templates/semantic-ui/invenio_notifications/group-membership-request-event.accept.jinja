{% set request = notification.context.request %}
{% set topic = request.topic %}
{% set topic_name = topic.get("description") or topic.get("name", topic.id) %}
{% set request_html_page = request.links.self_html %}

{%- block subject -%}
    {{ _("Your request to join group '{topic_name}' has been accepted").format(topic_name=topic_name) }}
{%- endblock subject -%}

{%- block html_body -%}
    {% trans topic_name=topic_name, link=request_html_page %}
<p>
Your request to join the group "{{topic_name}}" has been accepted. You are now a member of the group. You can see the request at
<a href="{{link}}">{{link}}</a>
</p>
    {% endtrans %}
    <table style="font-family:'Lato',Helvetica,Arial,sans-serif;border-spacing:15px">
        <tr>
            <td style="font-size:smaller">{{ _("This is an auto-generated message. To manage notifications, visit your")}} <a href="{{account_settings_link}}">{{ _("account settings")}}</a>.</td>
        </tr>
    </table>
{%- endblock html_body -%}

{%- block plain_body -%}
    {% trans topic_name=topic_name, link=request_html_page %}
Your request to join the group "{{topic_name}}" has been accepted. You are now a member of the group. You can see the request at
{{link}}
    {% endtrans %}

{%- endblock plain_body -%}
